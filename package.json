{
  "name": "jaldrishti",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch backend/src/devServer.ts",
    "dev:all": "concurrently --kill-others-on-fail -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "build:api": "node scripts/build-api.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "preview": "vite preview",
    "doctor": "node scripts/doctor.mjs",
    "check:all": "npm run check && npm run build && npm run build:api && npm run smoke:lambda",
    "smoke:lambda": "node scripts/smoke-lambda.mjs",
    "package:web": "npm run build && node scripts/package-web.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-polly": "^3.1148.0",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/aws-lambda": "^8.10.164",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "aws-sdk-client-mock": "^4.1.0",
    "concurrently": "^10.0.6",
    "dynalite": "^4.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
