# Copy to .env.local (git-ignored). Everything prefixed VITE_ is compiled into
# the PUBLIC browser bundle — never put secrets here.
# The map uses OpenStreetMap tiles, so no map key is needed.

# Reports API. Local: http://localhost:8787 (npm run dev:api). Prod: the SAM output "ApiUrl".
VITE_API_BASE_URL=http://localhost:8787
